# Oracle Database Configuration
# Replace with your actual Oracle credentials after starting the Docker container.
# The service name for gvenzl/oracle-free is FREEPDB1 by default.
DB_USER=system
DB_PASSWORD=your_oracle_password
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE_NAME=FREEPDB1

# LLM Configuration — Google Gemini (default)
# Get a free API key at: https://aistudio.google.com/app/apikey
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash
# Set LLM_PROVIDER=openai and update LLM_MODEL to switch to OpenAI
LLM_PROVIDER=gemini

# FastAPI Server Settings
HOST=127.0.0.1
PORT=8000
